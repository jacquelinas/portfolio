        technologies: ["Integración IA (Gemini)", "Protocolo LTI", "Análisis Critical Path", "UX/UI & DER", "Soporte Técnico"],
        imageUrl: resolve('/NEXA-presentacion.gif'), 
        liveUrl: "https://docs.google.com/document/d/1I345L6LWy075HwAGpAGklrV-T6qhsGbm93g2jlckzEA/edit?usp=sharing", // Botón: Documentación
        demoUrl: "https://lti-accessibility-tool-front.onrender.com/", // Botón: Ver App
        articleUrl: "https://innovalab.bue.edu.ar/foro", // Botón: Nota Oficial GCBA
    },
    {
