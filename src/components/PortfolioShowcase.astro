// 3. Define los Proyectos Secundarios (reusando la data anterior) [cite: 23, 25, 26]
const secondaryProjects: ProjectCardProps[] = [
    {
        title: "MINA INFORMÁTICA",
        description: `Desarrollo y mantenimiento web para mi organización de Soporte Técnico. Foco en presencia online y servicios.`,
        technologies: ["Astro", "Tailwind CSS", "JavaScript", "SEO","Firebase","Cloudflare","GitHub","Google Cloud CLI",],
        imageUrl: resolve('/mina-informatica.png'),
        liveUrl: "https://minainformatica.com",
        githubUrl: "",
    },
    {
        title: "B POLYGLOT TIMER",
        description: `Herramienta web para la comunidad de aprendizaje de idiomas. Funcionalidad de temporizador con reglas específicas.`,
        technologies: ["React", "Vite", "Styled Components", "State Management"],
        imageUrl: resolve('/brice-timer.png'),
        liveUrl: "https://minainformatica.com/languagetimer",
        githubUrl: "https://github.com/tu-usuario/brice-language-timer",
    },
    {
        title: "MeshCentral",
        description: `Despliegue de aplicación web en Google Cloud para administración remota (Intel AMT). Configuración de instancia, seguridad (HTTPS), reglas de firewall y puesta en marcha del servicio MeshCentral.`,
        technologies: ["Google Cloud CLI", "VM", "HTTPS", "Firewall", "MeshCentral","Cloudflare"],
        imageUrl: resolve('/meshcentral.png'),
        liveUrl: "https://minainformatica.online/",
        githubUrl: "https://www.meshcommander.com/meshcommander/mesh-commander-screens",
    },
