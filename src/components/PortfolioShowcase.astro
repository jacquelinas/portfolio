---
// 1. Importa los dos tipos de componentes de proyecto
import FeaturedProject from './FeaturedProject.astro';
import ProjectGrid from './ProjectGrid.astro';
import type { Props as ProjectCardProps } from './ProjectCard.astro';

// Normaliza rutas de imágenes respecto al BASE_URL (soporta despliegues en subcarpetas)
