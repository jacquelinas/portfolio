        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom">
            <div class="bottom-content">
                <p class="copyright">
                    © 2026 Jacqueline Valenzuela · <span class="accent-text">MINA INFORMÁTICA</span>. Powered by Astro & Cloudflare.
                </p>
                <button class="scroll-to-top" id="scrollToTopBtn" aria-label="Volver al inicio">
                    <span>Inicio</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer {
        position: relative;
        background: linear-gradient(180deg, rgba(5, 10, 20, 0.95), #030712);
        color: var(--color-text-primary);
        padding-top: 3.5rem;
        padding-bottom: 2rem;
        border-top: 1px solid rgba(0, 212, 255, 0.15);
        overflow: hidden;
    }

    :global(.light-theme) .footer {
        background: linear-gradient(180deg, rgba(240, 244, 248, 0.95), #e2e8f0);
        border-top: 1px solid rgba(2, 132, 199, 0.2);
    }

    .footer-glow-line {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
        gap: 2.5rem;
        margin-bottom: 3rem;
    }

    .brand-col {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .footer-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

    .logo-badge {
        font-size: 1rem;
        font-weight: 800;
        padding: 0.25rem 0.6rem;
        border-radius: 8px;
        background: rgba(0, 212, 255, 0.12);
        color: var(--color-accent);
        border: 1px solid rgba(0, 212, 255, 0.3);
    }

    .logo-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .footer-tagline {
        font-size: 0.88rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
        margin: 0;
    }

    .system-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        background: rgba(0, 212, 255, 0.06);
        border: 1px solid rgba(0, 212, 255, 0.18);
        border-radius: 20px;
        width: fit-content;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #00ff88;
        box-shadow: 0 0 8px #00ff88;
    }

    .status-text {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-secondary);
    }

    .footer-heading {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-accent);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 1.2rem 0;
    }

    .footer-nav, .footer-ecosystem {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .footer-link {
        text-decoration: none;
        color: var(--color-text-secondary);
        font-size: 0.9rem;
        transition: all 0.25s ease;
    }

    .footer-link:hover {
        color: var(--color-accent);
        transform: translateX(4px);
    }

    .ecosystem-link, .ecosystem-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color 0.25s ease;
    }

    .ecosystem-link:hover {
        color: var(--color-accent);
    }

    .social-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .social-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(0, 212, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-primary);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    :global(.light-theme) .social-btn {
        background: rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    .social-btn:hover {
        background: rgba(0, 212, 255, 0.12);
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-3px);
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 1.5rem;
    }

    :global(.light-theme) .footer-bottom {
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    .bottom-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .copyright {
        font-size: 0.82rem;
        color: var(--color-muted);
        margin: 0;
    }

    .accent-text {
        color: var(--color-accent);
        font-weight: 600;
    }

    .scroll-to-top {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(0, 212, 255, 0.1);
        color: var(--color-accent);
        border: 1px solid rgba(0, 212, 255, 0.25);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .scroll-to-top:hover {
        background: var(--color-accent);
        color: #fff;
        transform: translateY(-2px);
    }

    /* Responsive */
    @media (max-width: 900px) {
        .footer-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }
    }

    @media (max-width: 550px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }
        .bottom-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const scrollBtn = document.getElementById('scrollToTopBtn');
        if (scrollBtn) {
            scrollBtn.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        }
    });
</script>