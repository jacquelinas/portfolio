                            <span>MINA INFORMÁTICA</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://discord.gg/nQmQT44pv?event=1419473568508543076" target="_blank" rel="noopener noreferrer" class="ecosystem-link">
