---
export interface Props {
    title: string;
    challenge: string;
    solution: string;
    technologies: string[];
    imageUrl?: string;
    liveUrl?: string;
    githubUrl?: string;
    demoUrl?: string;
    articleUrl?: string;
}

const { title, challenge, solution, technologies, imageUrl, liveUrl, githubUrl, demoUrl, articleUrl } = Astro.props;
---
<article class="featured-project surface-card">
    <div class="featured-image">
        {imageUrl ? (
            <a href={imageUrl} target="_blank" rel="noopener">
                <img src={imageUrl} alt={title} loading="lazy" class="zoomable" data-full={imageUrl} />
            </a>
         ) : (
             <div class="placeholder-project">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
             </div>
         )}
    </div>

    <div class="featured-content">
        <h3 class="featured-title">{title}</h3>

        <div class="project-technologies">
            {technologies.map((tech) => (
                <span class="tech-tag">{tech}</span>
            ))}
        </div>

        <div class="featured-details">
            <h4 class="details-heading">The Challenge</h4>
            <p>{challenge}</p>
            
            <h4 class="details-heading">My Solution</h4>
            <p>{solution}</p>
        </div>

        <div class="project-links">
            {liveUrl && (
                <a href={liveUrl} class="btn btn-primary project-doc-btn" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                    <span class="label-desktop">Project Documentation</span>
                    <span class="label-mobile">Docs</span>
                </a>
            )}
            
            {demoUrl && (
                <a href={demoUrl} class="project-link" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    <span>View App</span>
                </a>
            )}

            {articleUrl && (
                <a href={articleUrl} class="project-link" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                    <span>Official Article</span>
                </a>
            )}

            {githubUrl && (
                <a href={githubUrl} class="project-link" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    <span>Code</span>
                </a>
            )}
        </div>
    </div>
</article>

<style>
    .featured-project {
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        margin-bottom: clamp(2rem, 5vw, 2.75rem);
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
        background: linear-gradient(145deg, rgba(14, 23, 41, 0.92), rgba(7, 13, 23, 0.9));
        border: 1px solid rgba(0, 212, 255, 0.16);
        backdrop-filter: blur(24px);
    }

    :global(.light-theme) .featured-project {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(2, 132, 199, 0.2);
    }

    .featured-project:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-strong);
        border-color: rgba(0, 212, 255, 0.4);
    }

    :global(.light-theme) .featured-project:hover {
        border-color: rgba(2, 132, 199, 0.4);
    }

    .featured-image {
        height: 240px;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    :global(.light-theme) .featured-image {
        background: rgba(0, 0, 0, 0.03);
    }

    .featured-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .featured-project:hover .featured-image img {
        transform: scale(1.05);
    }

    .placeholder-project {
        color: var(--color-accent);
        opacity: 0.6;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .featured-content {
        padding: clamp(1.75rem, 4vw, 2.4rem);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .featured-title {
        font-size: clamp(1.4rem, 3vw, 1.75rem);
        font-weight: 700;
        margin: 0;
        color: var(--color-text-primary);
    }

    .featured-details {
        margin-top: 0.5rem;
        line-height: 1.65;
        color: var(--color-text-secondary);
    }

    .details-heading {
        font-size: clamp(0.98rem, 2vw, 1.1rem);
        font-weight: 700;
        color: var(--color-accent);
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.01em;
    }

    .project-technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .tech-tag {
        background: rgba(0, 212, 255, 0.12);
        color: var(--color-accent);
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-size: clamp(0.78rem, 1.6vw, 0.9rem);
        white-space: nowrap;
        border: 1px solid rgba(0, 212, 255, 0.22);
        letter-spacing: 0.01em;
        font-weight: 500;
    }

    :global(.light-theme) .tech-tag {
        background: rgba(2, 132, 199, 0.1);
        border: 1px solid rgba(2, 132, 199, 0.25);
    }

    .project-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: auto;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
    }

    :global(.light-theme) .project-links {
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    .project-link {
        text-decoration: none;
        color: var(--color-accent);
        font-weight: 600;
        transition: color 0.3s ease, transform 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .project-link:hover {
        color: var(--color-accent-strong);
        transform: translateY(-2px);
    }

    .project-doc-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.2rem;
        font-weight: 700;
        box-shadow: 0 10px 28px rgba(0, 212, 255, 0.35);
        text-transform: none;
        white-space: nowrap;
    }

    .project-doc-btn .label-mobile { display: none; }

    @media (min-width: 768px) {
        .featured-project {
            flex-direction: row;
        }
 
        .featured-image {
            flex: 2;
            min-height: 100%;
        }
 
        .featured-content {
            flex: 3;
            padding: clamp(2.2rem, 5vw, 2.8rem);
        }
    }
 
    @media (max-width: 768px) {
        .featured-image {
            height: 220px;
        }
    }

    @media (max-width: 480px) {
        .project-doc-btn {
            font-size: 0.85rem;
            padding: 0.55rem 0.9rem;
        }
        .project-doc-btn .label-desktop { display: none; }
        .project-doc-btn .label-mobile { display: inline; }
    }
</style>