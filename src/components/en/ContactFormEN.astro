                        </button>
                    </div>

                    <div class="form-message" id="formMessageEN"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    /* Estilos idénticos a ContactForm.astro */
    .contact { position: relative; overflow: hidden; }
    .contact-header { text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
    .contact-wrapper { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; }
    .contact-info-card { background: linear-gradient(135deg, rgba(10, 20, 38, 0.85), rgba(7, 13, 24, 0.9)); border: 1px solid rgba(0, 212, 255, 0.18); border-radius: var(--radius-lg); padding: clamp(1.75rem, 4vw, 2.5rem); backdrop-filter: blur(20px); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; }
    :global(.light-theme) .contact-info-card { background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(2, 132, 199, 0.2); }
    .status-badge { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.9rem; background: rgba(0, 255, 136, 0.08); border: 1px solid rgba(0, 255, 136, 0.25); border-radius: 999px; width: fit-content; margin-bottom: 1.5rem; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background-color: #00ff88; box-shadow: 0 0 8px #00ff88; }
    .status-text { font-size: 0.82rem; font-weight: 600; color: #00ff88; }
    .info-title { font-size: 1.4rem; font-weight: 700; color: var(--color-text-primary); margin: 0 0 0.5rem 0; }
    .info-desc { font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0 0 1.75rem 0; }
    .info-channels { display: flex; flex-direction: column; gap: 0.85rem; margin-top: auto; }
    .channel-card { display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(0, 212, 255, 0.12); border-radius: var(--radius-md); text-decoration: none; transition: all 0.3s ease; }
    :global(.light-theme) .channel-card { background: rgba(0, 0, 0, 0.02); border: 1px solid rgba(0, 0, 0, 0.08); }
    .channel-icon { width: 38px; height: 38px; border-radius: 10px; background: rgba(0, 212, 255, 0.1); border: 1px solid rgba(0, 212, 255, 0.2); display: flex; align-items: center; justify-content: center; color: var(--color-accent); flex-shrink: 0; }
    .channel-details { display: flex; flex-direction: column; }
    .channel-label { font-size: 0.75rem; font-weight: 600; color: var(--color-muted); text-transform: uppercase; }
    .channel-val { font-size: 0.9rem; font-weight: 600; color: var(--color-text-primary); word-break: break-all; }
    .contact-form-container { background: linear-gradient(135deg, rgba(7, 14, 28, 0.88), rgba(11, 22, 44, 0.92)); border: 1px solid rgba(0, 212, 255, 0.18); border-radius: var(--radius-lg); padding: clamp(1.75rem, 4vw, 2.5rem); backdrop-filter: blur(20px); box-shadow: var(--shadow-soft); }
    :global(.light-theme) .contact-form-container { background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(2, 132, 199, 0.2); }
    .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-bottom: 1.5rem; }
    .full-width { grid-column: span 2; }
    .form-group { position: relative; display: flex; flex-direction: column; }
    .form-group input, .form-group textarea { width: 100%; padding: 0.85rem 0 0.4rem 0; background: transparent; border: none; border-bottom: 2px solid rgba(255, 255, 255, 0.15); color: var(--color-text-primary); font-size: 0.95rem; font-family: inherit; transition: border-color 0.3s ease; resize: vertical; }
    :global(.light-theme) .form-group input, :global(.light-theme) .form-group textarea { border-bottom-color: rgba(0, 0, 0, 0.15); }
    .form-group input:focus, .form-group textarea:focus { outline: none; border-bottom-color: var(--color-accent); }
    .form-group label { position: absolute; top: 0.85rem; left: 0; display: flex; align-items: center; gap: 0.4rem; color: var(--color-muted); font-size: 0.9rem; pointer-events: none; transition: all 0.3s ease; transform-origin: left top; }
    .form-group input:focus + label, .form-group textarea:focus + label, .form-group input:not(:placeholder-shown) + label, .form-group textarea:not(:placeholder-shown) + label { transform: translateY(-1.2rem) scale(0.82); color: var(--color-accent); }
    .form-line { position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: linear-gradient(90deg, var(--color-accent), #00F5FF); transition: width 0.35s ease; }
    .form-group input:focus ~ .form-line, .form-group textarea:focus ~ .form-line { width: 100%; }
    .submit-btn { width: 100%; padding: 0.95rem 1.5rem; border-radius: 999px; font-size: 1rem; font-weight: 700; cursor: pointer; border: 1px solid rgba(0, 212, 255, 0.5); background: linear-gradient(135deg, var(--color-accent), #0066ff); color: #fff; box-shadow: var(--shadow-soft); display: flex; align-items: center; justify-content: center; gap: 0.6rem; transition: all 0.3s ease; position: relative; }
    .submit-btn:hover { transform: translateY(-3px); box-shadow: var(--shadow-strong); background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent)); }
    .form-message { margin-top: 1.25rem; padding: 0.85rem 1rem; border-radius: 12px; text-align: center; font-size: 0.9rem; font-weight: 600; opacity: 0; transform: translateY(10px); transition: all 0.3s ease; display: none; }
    .form-message.show { opacity: 1; transform: translateY(0); display: block; }
    .form-message.success { background: rgba(0, 255, 136, 0.12); color: #00ff88; border: 1px solid rgba(0, 255, 136, 0.3); }
    .form-message.error { background: rgba(255, 68, 68, 0.12); color: #ff4444; border: 1px solid rgba(255, 68, 68, 0.3); }
    @media (max-width: 900px) { .contact-wrapper { grid-template-columns: 1fr; } .form-grid { grid-template-columns: 1fr; } .full-width { grid-column: span 1; } }
</style>

<script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('contactFormEN');
        if (!(form instanceof HTMLFormElement)) return;

        const submitBtn = form.querySelector('.submit-btn');
        const messageDiv = document.getElementById('formMessageEN');
        if (!(submitBtn instanceof HTMLButtonElement)) return;

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            submitBtn.classList.add('loading');
            submitBtn.disabled = true;
            
            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });
                
                if (response.ok) {
                    showMessage('Message sent successfully! I will get back to you shortly.', 'success');
                    form.reset();
                } else {
                    throw new Error('Error sending message');
                }
            } catch (error) {
                showMessage('There was an issue sending your message. Please try again.', 'error');
            } finally {
                submitBtn.classList.remove('loading');
                submitBtn.disabled = false;
            }
        });
        
        const showMessage = (/** @type {string} */ text, /** @type {'success'|'error'} */ type) => {
            if (!(messageDiv instanceof HTMLDivElement)) return;
            messageDiv.textContent = text;
            messageDiv.className = `form-message ${type} show`;
            setTimeout(() => { messageDiv.classList.remove('show'); }, 6000);
        }
    });
</script>