---
import { ClientRouter } from 'astro:transitions';
import Header from '../../components/Header.astro';
import HeroEN from '../../components/en/HeroEN.astro';	
import AboutEN from '../../components/en/AboutMeEN.astro';
import PortfolioShowcaseEN from '../../components/en/PortfolioShowcaseEN.astro';
import ContactEN from '../../components/en/ContactFormEN.astro';
import SkillsEN from '../../components/en/SkillsEN.astro';
import FooterEN from '../../components/en/FooterEN.astro';
import Analytics from '../../components/Analytics.astro';
import '../../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Jacqueline Valenzuela | L2/L3 Tech Support & Full Stack Developer</title>
		<meta name="description" content="Portfolio of Jacqueline Valenzuela - L2/L3 IT Infrastructure Specialist & Full Stack Developer" />
        
        <!-- Precarregado de fuentes -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        
        <!-- Transiciones de cliente sin recarga brusca -->
        <ClientRouter />

        <Analytics />
        <script is:inline>
            const theme = localStorage.getItem('theme');
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            }
        </script>
	</head>
	<body>
		<Header />
		<main>
			<HeroEN />
            <div id="about" class="section-shell">
				<AboutEN />
            </div>
            <div id="projects" class="section-shell">
				<PortfolioShowcaseEN />
            </div>
			<SkillsEN />
            <div id="contact" class="section-shell">
				<ContactEN />
            </div>
		</main>
		<FooterEN />
	</body>
</html>

<style>
	main { padding-top: 0; }
    .section-shell {
        padding-inline: clamp(1.5rem, 5vw, 4rem);
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(24px);
        transition: background 0.3s ease;
	}
	
    .section-shell:nth-child(odd) {
        background: radial-gradient(circle at 10% 20%, rgba(0, 212, 255, 0.08), transparent 55%),
                    radial-gradient(circle at 90% 10%, rgba(0, 245, 255, 0.05), transparent 45%),
                    linear-gradient(135deg, rgba(11, 22, 40, 0.9), rgba(5, 9, 18, 0.92));
	}
	
    .section-shell:nth-child(even) {
        background: radial-gradient(circle at 90% 20%, rgba(0, 212, 255, 0.08), transparent 55%),
                    radial-gradient(circle at 20% 10%, rgba(0, 245, 255, 0.05), transparent 45%),
                    linear-gradient(135deg, rgba(7, 13, 26, 0.92), rgba(13, 26, 48, 0.9));
    }

    :global(.light-theme) .section-shell:nth-child(odd) {
        background: radial-gradient(circle at 10% 20%, rgba(2, 132, 199, 0.06), transparent 55%),
                    linear-gradient(135deg, rgba(240, 244, 248, 0.95), rgba(226, 232, 240, 0.92));
    }

    :global(.light-theme) .section-shell:nth-child(even) {
        background: radial-gradient(circle at 90% 20%, rgba(2, 132, 199, 0.06), transparent 55%),
                    linear-gradient(135deg, rgba(226, 232, 240, 0.92), rgba(240, 244, 248, 0.95));
    }

    .section-shell > :global(section) { margin: 0; }
	::-webkit-scrollbar { width: 8px; }
	::-webkit-scrollbar-track { background: #0A0A0A; }
	::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #00D4FF, #00F5FF); border-radius: 4px; }
	::selection { background: rgba(0, 212, 255, 0.3); color: #FFFFFF; }
	html { scroll-behavior: smooth; }
	
	@keyframes fadeInUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>