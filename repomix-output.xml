---
// Contact form component
---

<section id="contact" class="contact">
    <div class="container">
        <div class="contact-header">
            <h2 class="section-title">Conectemos</h2>
            <p class="section-subtitle">¿Tienes un proyecto en mente? Hablemos sobre cómo puedo ayudarte.</p>
        </div>
        
        <div class="contact-content">
            <form class="contact-form" action="https://formspree.io/f/xbloyblv" method="POST" id="contactForm">
                <div class="form-row form-row--3">
                    <div class="form-group">
                        <input type="text" id="name" name="name" required>
                        <label for="name">Nombre</label>
                        <div class="form-line"></div>
                    </div>
                    <div class="form-group">
                        <input type="email" id="email" name="email" required>
                        <label for="email">Email</label>
                        <div class="form-line"></div>
                    </div>
                    <div class="form-group">
                        <input type="text" id="subject" name="subject" required>
                        <label for="subject">Asunto</label>
                        <div class="form-line"></div>
                    </div>
                </div>

                <div class="form-row form-row--message">
                    <div class="form-group message">
                        <textarea id="message" name="message" rows="3" required></textarea>
                        <label for="message">Mensaje</label>
                        <div class="form-line"></div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="submit-btn">
                            <span class="btn-text">Enviar Mensaje</span>
                            <div class="btn-loader"></div>
                            <svg class="btn-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22,2 15,22 11,13 2,9 22,2"></polygon>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Mensaje de éxito/error -->
                <div class="form-message" id="formMessage"></div>
            </form>
        </div>
    </div>
    
    <!-- Efectos de fondo -->
    <div class="contact-bg-effects">
        <div class="bg-grid"></div>
        <div class="bg-particles">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>
    </div>
</section>

<style>
    .contact {
        position: relative;
        background: radial-gradient(circle at 15% 20%, rgba(0, 212, 255, 0.1), transparent 55%),
                    linear-gradient(135deg, rgba(8, 16, 32, 0.92), rgba(12, 26, 48, 0.92));
        color: var(--color-text-primary);
        overflow: hidden;
        min-height: 60vh;
        display: flex;
        align-items: center;
        padding: clamp(2.5rem, 6vw, 3.5rem) 0;
        border-radius: var(--radius-lg);
        border: 1px solid rgba(0, 212, 255, 0.12);
        box-shadow: var(--shadow-soft);
    }

    .container {
        max-width: 960px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .contact-header {
        text-align: center;
        margin-bottom: clamp(2rem, 5vw, 2.75rem);
    }
    
    .contact-content {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        align-items: center;
    }
    
    .contact-form {
        background: linear-gradient(135deg, rgba(7, 14, 28, 0.85), rgba(11, 22, 44, 0.9));
        padding: clamp(1.25rem, 3vw, 1.75rem);
        border-radius: var(--radius-md);
        border: 1px solid rgba(0, 212, 255, 0.18);
        backdrop-filter: blur(16px);
        box-shadow: var(--shadow-soft);
        width: 100%;
        max-width: 960px;
    }
    
    .form-row {
        display: grid;
        gap: 0.9rem;
        margin-bottom: 0.9rem;
    }

    .form-row--3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-row--message {
        grid-template-columns: 2fr 1fr;
        align-items: end;
    }
    
    .form-group {
        position: relative;
        margin-bottom: 1.2rem;
    }
    
    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.55rem 0;
        background: transparent;
        border: none;
        border-bottom: 2px solid rgba(255, 255, 255, 0.15);
        color: var(--color-text-primary);
        font-size: clamp(0.9rem, 1.6vw, 1rem);
        transition: all 0.3s ease;
        resize: none;
    }

    .form-group.message textarea {
        min-height: 90px;
    }
    
    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-bottom-color: var(--color-accent);
    }
    
    .form-group input:focus + label,
    .form-group textarea:focus + label,
    .form-group input:not(:placeholder-shown) + label,
    .form-group textarea:not(:placeholder-shown) + label {
        transform: translateY(-0.9rem) scale(0.85);
        color: var(--color-accent);
    }

    .form-group label {
        position: absolute;
        top: 0.6rem;
        left: 0;
        color: var(--color-muted);
        font-size: clamp(0.8rem, 1.6vw, 0.9rem);
        transition: all 0.3s ease;
        pointer-events: none;
        transform-origin: left top;
    }
    
    .form-line {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--color-accent), #0066ff);
        transition: width 0.3s ease;
    }
    
    .form-group input:focus ~ .form-line,
    .form-group textarea:focus ~ .form-line {
        width: 100%;
    }
    
    .submit-btn {
        position: relative;
        width: 100%;
        padding: 0.85rem 1.35rem;
        border-radius: 30px;
        font-size: clamp(0.9rem, 1.6vw, 1rem);
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: linear-gradient(135deg, var(--color-accent), #0066ff);
        color: #fff;
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        transition: transform 0.3s ease, box-shadow 0.35s ease;
    }
    
    .submit-btn:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-strong);
        background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
    }

    .submit-btn.loading {
        pointer-events: none;
    }
    
    .submit-btn.loading .btn-text {
        opacity: 0;
    }
    
    .submit-btn.loading .btn-loader {
        opacity: 1;
    }
    
    .btn-loader {
        position: absolute;
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        opacity: 0;
    }
    
    .btn-icon {
        transition: transform 0.3s ease;
    }
    
    .submit-btn:hover .btn-icon {
        transform: translateX(3px);
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .form-message {
        margin-top: 1.5rem;
        padding: 1rem;
        border-radius: 10px;
        text-align: center;
        font-weight: 500;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
    }
    
    .form-message.show {
        opacity: 1;
        transform: translateY(0);
    }
    
    .form-message.success {
        background: rgba(0, 255, 136, 0.1);
        color: #00ff88;
        border: 1px solid rgba(0, 255, 136, 0.3);
    }
    
    .form-message.error {
        background: rgba(255, 68, 68, 0.1);
        color: #ff4444;
        border: 1px solid rgba(255, 68, 68, 0.3);
    }
    

    
    /* Efectos de fondo */
    .contact-bg-effects {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }
    
    .bg-grid {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: 
            linear-gradient(rgba(0, 212, 255, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 212, 255, 0.04) 1px, transparent 1px);
        background-size: 46px 46px;
        opacity: 0.45;
    }
    
    .bg-particles {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
    
    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: #00d4ff;
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
        box-shadow: 0 0 10px #00d4ff;
    }
    
    .particle:nth-child(1) {
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }
    
    .particle:nth-child(2) {
        top: 60%;
        right: 15%;
        animation-delay: 2s;
    }
    
    .particle:nth-child(3) {
        bottom: 30%;
        left: 20%;
        animation-delay: 4s;
    }
    
    .particle:nth-child(4) {
        top: 40%;
        right: 30%;
        animation-delay: 1s;
    }
    
    @keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
            opacity: 0.3;
        }
        50% {
            transform: translateY(-20px) rotate(180deg);
            opacity: 1;
        }
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .contact {
            padding: clamp(2.5rem, 12vw, 3rem) 1.25rem;
        }

        .contact-content {
            gap: 1.4rem;
        }

        .contact-form {
            padding: 1.25rem;
        }

        .form-row--3,
        .form-row--message {
            grid-template-columns: 1fr;
            gap: 0.2rem;
        }

        .form-actions {
            margin-top: 0.6rem;
        }
    }
</style>

<script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('contactForm');
        if (!(form instanceof HTMLFormElement)) return;

        const submitBtn = form.querySelector('.submit-btn');
        const messageDiv = document.getElementById('formMessage');
        if (!(submitBtn instanceof HTMLButtonElement)) return;

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Mostrar estado de carga
            submitBtn.classList.add('loading');
            submitBtn.disabled = true;
            
            try {
                const formData = new FormData(form);
                
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                
                if (response.ok) {
                    showMessage('¡Mensaje enviado correctamente! Te responderé pronto.', 'success');
                    form.reset();
                } else {
                    throw new Error('Error al enviar el mensaje');
                }
            } catch (error) {
                showMessage('Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.', 'error');
            } finally {
                // Ocultar estado de carga
                submitBtn.classList.remove('loading');
                submitBtn.disabled = false;
            }
        });
        
        const showMessage = (/** @type {string} */ text, /** @type {'success'|'error'} */ type) => {
            if (!(messageDiv instanceof HTMLDivElement)) return;
            messageDiv.textContent = text;
            messageDiv.className = `form-message ${type} show`;
            
            setTimeout(() => {
                messageDiv.classList.remove('show');
            }, 5000);
        }
    });
</script>
</file>

