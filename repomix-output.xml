        console.log('Botón Inicio clickeado');
        
        // Intentar múltiples métodos para asegurar que funcione
        const heroElement = document.getElementById('hero');
        
        if (heroElement) {
            console.log('Hero encontrado, haciendo scroll...');
            heroElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        } else {
            console.log('Hero no encontrado, usando fallback...');
            // Fallback: scroll hacia la parte superior
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }
        
        // Método alternativo por si el anterior falla
        setTimeout(() => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }, 100);
    }
    
    // Hacer la función global para que funcione desde onclick también
    window.scrollToTop = scrollToTop;
    
    // Mostrar/ocultar botón basado en la posición del scroll
    window.addEventListener('scroll', function() {
        const scrollButton = document.getElementById('scrollToTopBtn') as HTMLElement;
        const heroElement = document.getElementById('hero');
        
        if (scrollButton && heroElement) {
            const heroRect = heroElement.getBoundingClientRect();
            const isHeroVisible = heroRect.top >= 0 && heroRect.bottom <= window.innerHeight;
            
            if (!isHeroVisible && window.scrollY > 200) {
                scrollButton.style.opacity = '1';
                scrollButton.style.visibility = 'visible';
            } else {
                scrollButton.style.opacity = '0';
                scrollButton.style.visibility = 'hidden';
            }
        }
    });
    
    // Inicializar el botón como oculto y agregar event listener
    document.addEventListener('DOMContentLoaded', function() {
        const scrollButton = document.getElementById('scrollToTopBtn') as HTMLElement;
        if (scrollButton) {
            scrollButton.style.opacity = '0';
            scrollButton.style.visibility = 'hidden';
            scrollButton.style.transition = 'all 0.3s ease';
            
            // Agregar event listener
            scrollButton.addEventListener('click', function(e) {
                e.preventDefault();
                console.log('Botón clickeado via event listener');
                scrollToTop();
            });
        }
    });
</script>
</file>

