        }
 
        .about-media .photo-carousel {
            width: 250px;
            height: 250px;
            padding: 0.55rem;
        }
 
        .stat {
            min-width: auto;
            width: min(320px, 100%);
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 0.6rem;
