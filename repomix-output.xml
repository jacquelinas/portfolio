    .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: rgba(0, 212, 255, 0.22);
        cursor: pointer;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 212, 255, 0.35);
