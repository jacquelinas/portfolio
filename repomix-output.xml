<style>
    .portfolio-showcase {
        width: min(92%, 1100px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: clamp(2rem, 6vw, 3rem);
    }

    .showcase-header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .section-subtitle {
        max-width: 46rem;
