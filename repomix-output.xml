        gap: 0.5rem;
    }
    
    .tech-tag {
        background: rgba(0, 212, 255, 0.12);
        color: var(--color-accent);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: clamp(0.78rem, 1.4vw, 0.85rem);
        white-space: nowrap;
        border: 1px solid rgba(0, 212, 255, 0.2);
