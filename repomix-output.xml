</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const nav = document.querySelector('.nav');
        const toggle = document.getElementById('navToggle');
        const collections = document.getElementById('site-navigation');

        if (!nav || !(toggle instanceof HTMLButtonElement) || !collections) {
            return;
        }

        const body = document.body;

        const closeMenu = () => {
            toggle.setAttribute('aria-expanded', 'false');
            nav.dataset.menuOpen = 'false';
            body.classList.remove('no-scroll');
        };

        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            if (expanded) {
                closeMenu();
            } else {
                toggle.setAttribute('aria-expanded', 'true');
                nav.dataset.menuOpen = 'true';
                body.classList.add('no-scroll');
            }
        });

        collections.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                closeMenu();
            });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeMenu();
            }
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 900) {
                closeMenu();
            }
        });
    });
</script>
</file>

