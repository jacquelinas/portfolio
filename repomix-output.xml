        text-align: justify;
    }

    .showcase-header .section-title {
        text-align: justify;
        max-width: 46rem;
        margin: 0 auto;
    }

    .featured-list {
        display: flex;
        flex-direction: column;
        gap: clamp(2rem, 5vw, 2.75rem);
    }

    /* Lightbox */
    .lightbox {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }
    .lightbox[hidden] { display: none; }

    .lightbox-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(2px);
    }
    .lightbox-frame {
        position: relative;
        max-width: 96vw;
        max-height: 96vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0;
        gap: 0.5rem;
    }
    .lightbox-viewport {
         width: min(96vw, 1200px);
         height: min(86vh, 800px);
         overflow: hidden; /* sin barras */
         display: grid;
         place-items: center;
         border-radius: 10px;
         background: rgba(0,0,0,0.15);
    }
    .lightbox-image {
        display: block;               /* fuerza pintura */
        max-width: 100% !important;
        max-height: 100% !important;
        width: auto;
        height: auto;
        object-fit: contain;           /* se ve completa al abrir */
        image-rendering: auto;         /* png grandes */
        box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        border-radius: 8px;
        transition: transform 0.15s ease-out;
        transform: translate3d(0,0,0) scale(1);
        cursor: zoom-in;
        will-change: transform;
    }
    .lightbox-close {
        position: absolute;
        top: -10px;
        right: -10px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.3);
        cursor: pointer;
        font-size: 20px;
        display: grid;
        place-items: center;
        backdrop-filter: blur(3px);
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.25); }
</style>

<script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
        const lightbox = document.getElementById('imageLightbox');
        const img = document.getElementById('lightboxImage');
        const caption = document.querySelector('.lightbox-caption');
        const viewport = document.querySelector('.lightbox-viewport');

        if (!(lightbox instanceof HTMLElement) || !(img instanceof HTMLImageElement) || !(viewport instanceof HTMLElement)) return;

        let scale = 1;
        let translateX = 0;
        let translateY = 0;
        const minScale = 1;
        const maxScale = 4;
        let isDragging = false;
        let startX = 0, startY = 0;

        function applyTransform() {
            img.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
            img.style.cursor = scale === 1 ? 'zoom-in' : 'grab';
        }

        function resetTransform() {
            scale = 1;
            translateX = 0;
            translateY = 0;
            applyTransform();
        }

        /**
         * @param {string} src
         * @param {string} [alt]
         */
        function openLightbox(src, alt) {
            img.src = src;
            resetTransform();
            if (caption) caption.textContent = alt || '';
            lightbox.hidden = false;
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.classList.add('no-scroll');
        }

        function closeLightbox() {
            img.src = '';
            lightbox.hidden = true;
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('no-scroll');
        }

        // Apertura desde cualquier imagen zoomable SOLO en featured-list
        document.addEventListener('click', (ev) => {
            const target = ev.target;
            if (target instanceof HTMLImageElement && target.classList.contains('zoomable')) {
                // Solo si la imagen pertenece al bloque de destacados
                if (!target.closest('.featured-list')) return;
                ev.preventDefault();
                const full = target.getAttribute('data-full') || target.currentSrc || target.src;
                // Preload para evitar overlay sin imagen
                const test = new Image();
                test.onload = () => openLightbox(full, target.alt);
                test.onerror = () => window.open(full, '_blank');
                test.src = full;
            }
            if ((target instanceof HTMLElement) && target.hasAttribute('data-close')) {
                closeLightbox();
            }
        });

        // Teclado: Enter/Espacio abre
        document.addEventListener('keydown', (ev) => {
            const active = document.activeElement;
            if ((ev.key === 'Enter' || ev.key === ' ') && active instanceof HTMLImageElement && active.classList.contains('zoomable')) {
                if (!active.closest('.featured-list')) return;
                ev.preventDefault();
                const full = active.getAttribute('data-full') || active.currentSrc || active.src;
                const test = new Image();
                test.onload = () => openLightbox(full, active.alt);
                test.onerror = () => window.open(full, '_blank');
                test.src = full;
            }
        });

        // Cerrar con ESC
        document.addEventListener('keydown', (ev) => {
            if (ev.key === 'Escape' && !lightbox.hidden) closeLightbox();
        });

        // Click para alternar zoom 1x/2x centrado
        img.addEventListener('click', () => {
            if (scale === 1) {
                scale = 2;
            } else {
                scale = 1;
                translateX = 0;
                translateY = 0;
            }
            applyTransform();
        });

        // Zoom con rueda del ratón (sin scroll, centrado)
        viewport.addEventListener('wheel', (e) => {
            e.preventDefault();
            const delta = Math.sign(e.deltaY);
            const factor = -delta * 0.2; // sensibilidad
            scale = Math.min(maxScale, Math.max(minScale, scale + factor));
            applyTransform();
        }, { passive: false });

        // Arrastrar para desplazarse cuando hay zoom
        viewport.addEventListener('mousedown', (e) => {
            if (scale === 1) return;
            isDragging = true;
            startX = e.clientX - translateX;
            startY = e.clientY - translateY;
            img.style.cursor = 'grabbing';
        });
        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            translateX = e.clientX - startX;
            translateY = e.clientY - startY;
            applyTransform();
        });
        window.addEventListener('mouseup', () => {
            if (!isDragging) return;
            isDragging = false;
            img.style.cursor = 'grab';
        });

        // Soporte básico táctil: doble toque para alternar zoom
        let lastTap = 0;
        viewport.addEventListener('touchend', (e) => {
            const now = Date.now();
            if (now - lastTap < 300) {
                // doble tap
                if (scale === 1) scale = 2; else { scale = 1; translateX = 0; translateY = 0; }
                applyTransform();
            }
            lastTap = now;
        });
    });
</script>
</file>

