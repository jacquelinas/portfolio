    .photo-slide:nth-child(5) .work-photo,
    .photo-slide:nth-child(6) .work-photo,
    .photo-slide:nth-child(7) .work-photo,
    .photo-slide:nth-child(8) .work-photo {
        object-position: center;
    }
</style>

<script>
// @ts-nocheck
	let currentSlideIndex = 0;
	let autoPlayInterval = 0;
	let resumeTimeout = 0;
	let isUserInteracting = false;
	let cycleCount = 0;
	const totalCycles = 2;
	let isAutoPlayActive = true;
	
	document.addEventListener('DOMContentLoaded', () => {
		const slides = Array.from(document.querySelectorAll('.photo-slide'));
		const dots = Array.from(document.querySelectorAll('.dot'));
		const controls = Array.from(document.querySelectorAll('.carousel-btn'));
		const carousel = document.querySelector('.photo-carousel');

		if (slides.length === 0 || dots.length === 0 || !carousel) {
			return;
		}

		const totalSlides = slides.length;

		/**
		 * @param {number} index
		 * @returns {void}
		 */
		const setActiveSlide = (index) => {
			slides.forEach((slide, slideIndex) => {
				const isActive = slideIndex === index;
				slide.classList.toggle('active', isActive);
				slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
			});

			dots.forEach((dot, dotIndex) => {
				const isActive = dotIndex === index;
				dot.classList.toggle('active', isActive);

				if (isActive) {
					dot.setAttribute('aria-current', 'true');
					dot.setAttribute('tabindex', '0');
				} else {
					dot.removeAttribute('aria-current');
					dot.setAttribute('tabindex', '-1');
				}
			});
		};

		/**
		 * @param {number} index
		 * @returns {void}
		 */
		const goToSlide = (index) => {
			currentSlideIndex = (index + totalSlides) % totalSlides;
			setActiveSlide(currentSlideIndex);
		};

		/**
		 * @param {number} direction
		 * @returns {void}
		 */
		const changeSlide = (direction) => {
			const previousIndex = currentSlideIndex;
			goToSlide(previousIndex + direction);

			if (direction > 0 && previousIndex === totalSlides - 1) {
				cycleCount += 1;

				if (cycleCount >= totalCycles && isAutoPlayActive) {
					stopAutoPlay();
					goToSlide(0);
				}
			}
		};

		function clearTimers() {
			if (autoPlayInterval !== 0) {
				window.clearInterval(autoPlayInterval);
				autoPlayInterval = 0;
			}

			if (resumeTimeout !== 0) {
				window.clearTimeout(resumeTimeout);
				resumeTimeout = 0;
			}
		}

		function startAutoPlay() {
			if (!isAutoPlayActive || isUserInteracting || autoPlayInterval !== 0) {
				return;
			}

			autoPlayInterval = window.setInterval(() => {
				if (!isUserInteracting) {
					changeSlide(1);
				}
			}, 6000);
		}

		function pauseAutoPlay() {
			isUserInteracting = true;
			clearTimers();

			resumeTimeout = window.setTimeout(() => {
				if (isAutoPlayActive) {
					isUserInteracting = false;
					startAutoPlay();
				}
			}, 10000);
		}

		function stopAutoPlay() {
			isAutoPlayActive = false;
			clearTimers();
		}

		controls.forEach((button) => {
			button.addEventListener('click', () => {
				const directionAttr = button.getAttribute('data-direction');
				const direction = directionAttr ? Number(directionAttr) : 0;

				if (!Number.isNaN(direction) && direction !== 0) {
					changeSlide(direction);
					pauseAutoPlay();
				}
			});
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const targetAttr = dot.getAttribute('data-target');
				const target = targetAttr ? Number(targetAttr) : NaN;

				if (!Number.isNaN(target)) {
					goToSlide(target);
					pauseAutoPlay();
				}
			});

			dot.addEventListener('keydown', (event) => {
				if (!(event instanceof KeyboardEvent)) {
					return;
				}

				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					const targetAttr = dot.getAttribute('data-target');
					const target = targetAttr ? Number(targetAttr) : NaN;

					if (!Number.isNaN(target)) {
						goToSlide(target);
						pauseAutoPlay();
					}
				}
			});
		});

		carousel.addEventListener('mouseenter', () => {
			pauseAutoPlay();
		});

		carousel.addEventListener('mouseleave', () => {
			if (isAutoPlayActive) {
				isUserInteracting = false;
				startAutoPlay();
			}
		});

		setActiveSlide(currentSlideIndex);
		startAutoPlay();
	});
</script>
</file>

<file path="src/components/Analytics.astro">
---
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleScript = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT ?? 'https://plausible.io/js/script.js';

const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

{plausibleDomain && (
    <script defer src={plausibleScript} data-domain={plausibleDomain}></script>
)}

{umamiSrc && umamiWebsiteId && (
    <script
        async
        defer
        src={umamiSrc}
        data-website-id={umamiWebsiteId}
    ></script>
)}
</file>

