        transition: color 0.3s ease, transform 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    
    .project-link:hover {
        color: var(--color-accent-strong);
        transform: translateY(-2px);
    }
</style>
