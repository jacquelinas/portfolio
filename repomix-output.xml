        }
    }
    
    @media (max-width: 768px) {
        .about-content {
            gap: 1.5rem;
            padding: clamp(1.35rem, 6.5vw, 2.2rem);
        }
 
        .about-title {
            font-size: clamp(1.85rem, 7vw, 2.2rem);
            margin-bottom: 0.55rem;
        }

        .about-description {
            font-size: clamp(0.9rem, 3.2vw, 0.98rem);
            line-height: 1.5;
        }

        .about-description--primary {
            margin-bottom: clamp(0.4rem, 2vw, 0.75rem);
        }

        .about-description--secondary {
            margin-bottom: clamp(0.1rem, 1vw, 0.4rem);
        }

        .about-stats {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
