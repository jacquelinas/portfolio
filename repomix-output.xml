<file path="src/styles/global.css">
/* Estilos globales y variables de tema */

:root {
  --color-bg: #050608;
  --color-bg-alt: #0a0f1f;
  --color-surface: rgba(12, 18, 34, 0.8);
  --color-surface-strong: #11182b;
  --color-text-primary: #f1f5f9;
  --color-text-secondary: #cbd5f5;
  --color-muted: #8a9ab8;
  --color-border: rgba(30, 64, 175, 0.35);
  --color-accent: #00d4ff;
  --color-accent-strong: #00f5ff;
  --color-accent-alt: #00ff88;

  --shadow-soft: 0 12px 40px rgba(10, 126, 255, 0.15);
  --shadow-strong: 0 18px 55px rgba(0, 212, 255, 0.22);

  --radius-lg: 24px;
  --radius-md: 18px;
  --radius-sm: 12px;
  --measure: 1200px;
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  background: radial-gradient(circle at 15% 15%, rgba(0, 212, 255, 0.12), transparent 45%),
              radial-gradient(circle at 80% 10%, rgba(0, 245, 255, 0.12), transparent 50%),
              var(--color-bg);
  color: var(--color-text-primary);
  line-height: 1.65;
  overflow-x: hidden;
}

body.no-scroll {
  overflow: hidden;
}

a {
  color: inherit;
}

.container {
  width: min(92%, var(--measure));
  margin-inline: auto;
}

.section-shell {
  padding: clamp(4rem, 8vw, 7rem) 0;
  position: relative;
}

.section-title {
  margin: 0 0 1.25rem;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-strong));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-align: center;
  text-shadow: 0 0 20px rgba(0, 212, 255, 0.35);
}

.section-subtitle {
  margin: 0 auto;
  max-width: 40rem;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: clamp(1rem, 2.4vw, 1.2rem);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  background: rgba(0, 212, 255, 0.12);
  color: var(--color-accent);
  font-size: 0.8rem;
  border: 1px solid rgba(0, 212, 255, 0.25);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.95rem 2.3rem;
  border-radius: 999px;
  font-weight: 600;
  letter-spacing: 0.01em;
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.3s ease, box-shadow 0.35s ease, background 0.35s ease;
  position: relative;
  overflow: hidden;
  border: 2px solid transparent;
  min-width: 180px;
}

.btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
  transform: translateX(-100%);
  transition: transform 0.5s ease;
}

.btn:hover::after {
  transform: translateX(100%);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-accent), #0066ff);
  color: #fff;
  border-color: rgba(0, 212, 255, 0.65);
  box-shadow: var(--shadow-soft);
}

.btn-primary:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-strong);
  background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
}

.btn-outline {
  background: transparent;
  color: var(--color-accent);
  border-color: rgba(0, 212, 255, 0.55);
  box-shadow: 0 10px 30px rgba(0, 212, 255, 0.18);
}

.btn-outline:hover {
  transform: translateY(-4px);
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.15), rgba(0, 245, 255, 0.25));
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.04);
  color: var(--color-text-primary);
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 12px 36px rgba(0, 212, 255, 0.16);
}

.btn-secondary:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 45px rgba(0, 212, 255, 0.22);
  background: rgba(255, 255, 255, 0.08);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.02);
  border-color: rgba(255, 255, 255, 0.08);
  color: var(--color-text-secondary);
}

.btn-ghost:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 255, 255, 0.2);
}

.surface-card {
  background: linear-gradient(145deg, rgba(14, 23, 41, 0.92), rgba(7, 13, 23, 0.9));
  border: 1px solid rgba(0, 212, 255, 0.12);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(24px);
}

.zoomable {
  cursor: zoom-in;
}

@media (max-width: 768px) {
  .btn {
    width: 100%;
    min-width: 0;
  }

  .section-title {
    font-size: clamp(1.9rem, 7vw, 2.4rem);
  }

  .section-shell {
    padding: clamp(3.5rem, 12vw, 5rem) 0;
  }
}
</file>

